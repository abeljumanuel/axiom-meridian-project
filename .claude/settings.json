{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-openspec-before-pr.sh",
            "if": "Bash(gh pr create*)",
            "timeout": 15,
            "statusMessage": "Checking for an openspec change before opening the PR..."
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/check-release-version.sh",
            "if": "Bash(git tag*)",
            "timeout": 20,
            "statusMessage": "Checking that the release tag matches every version declaration and the CHANGELOG..."
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/check-release-version.sh",
            "if": "Bash(uv publish*)",
            "timeout": 20,
            "statusMessage": "Blocking local PyPI publish (CI publishes on tag)..."
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/check-release-version.sh",
            "if": "Bash(twine upload*)",
            "timeout": 20,
            "statusMessage": "Blocking local PyPI publish (CI publishes on tag)..."
          }
        ]
      }
    ]
  }
}
